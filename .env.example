# Copy to .env and fill in. .env is gitignored and must never be committed.

# Anthropic key, created inside a workspace with a $20/month spend limit.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Tavily search key (free tier).
TAVILY_API_KEY=tvly-replace-me

# Redis. Inside docker compose the host is "redis"; from the host use localhost.
REDIS_URL=redis://redis:6379/0

# Optional internal knobs (defaults are fine; tests override them).
# RA_LEASE_TTL_S=60
# RA_SWEEP_SECONDS=30
# RA_STUB=

# Host ports published by docker compose. Change these if 8000 or 6379 are busy.
# API_PORT=8000
# REDIS_PORT=6379
